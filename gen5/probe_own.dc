-- Unit probe for the ownership pass (gen5/g5_own.dc): parses small programs
-- from string literals, runs g5o_program and prints the IR dump.
-- Build: cat gen3-dcc-dc/dcc.dc gen5/g5_oir.dc gen5/g5_own.dc gen5/probe_own.dc > /tmp/own_full.dc
-- Run:   ./gen0-interp-rs/target/release/dacelo /tmp/own_full.dc
-- (Gen0-routed like probe_row_*.dc: fast, no RAM.)
--
-- Expected output: see the comment block at the end of this file.

let g5p_own_src name src =
  print_string ("== " ++ name ++ " ==\n") ;
  print_string (g5o_print_prog (g5o_program (parse_prog (lex_all src)))) ;
  print_string "\n"

-- A: borrow inference basics + drop-guided reuse
let g5p_own_a =
  "let id x = x\n"
  ++ "let rec len xs = case xs of | [] -> 0 | _ :: t -> 1 + len t\n"
  ++ "let rec map f xs = case xs of | [] -> [] | h :: t -> f h :: map f t\n"
  ++ "let pair x y = (x, y)\n"

-- B: closures (capture of a variable used again later; local let rec)
let g5p_own_b =
  "let mk n = let g = fun x -> x + n in (g, n)\n"
  ++ "let sum n = let rec go i = if i == 0 then n else go (i - 1) in go 3\n"

-- C: short-circuit, sequencing, saturated / unsaturated / over-saturated calls
let g5p_own_c =
  "let both a b = a && b > 1\n"
  ++ "let main () = print_int 1 ; print_int 2\n"
  ++ "let add a b = a + b\n"
  ++ "let id x = x\n"
  ++ "let use () = (add 1 2, add 1)\n"
  ++ "let over () = id add 1 2\n"

-- D: compound parameter pattern, owned scrutinee kept alive, nested reuse
let g5p_own_d =
  "let fst2 (a, b) = a\n"
  ++ "let swap p = case p of | (a, b) -> (b, a)\n"
  ++ "let keep xs = case xs of | [] -> xs | h :: t -> if h == 0 then xs else t\n"

let main () =
  g5p_own_src "A" g5p_own_a ;
  g5p_own_src "B" g5p_own_b ;
  g5p_own_src "C" g5p_own_c ;
  g5p_own_src "D" g5p_own_d

