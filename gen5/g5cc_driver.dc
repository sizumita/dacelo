-- ============================================================
-- gen5/g5cc_driver.dc -- Gen5 check-then-compile driver (fresh lineage)
--
-- CLI identical to dcc_1/dcc_4: ./dcc_6 <in.dc> <out_base>
-- Pipeline: load (modules) -> check all -> refuse partial/ill-typed
-- (BEFORE any output) -> legacy path (original source, byte-identical .s)
-- or Gen5 path (lowered source + record prelude) -> legacy backend.
-- Only Gen4-subset syntax is used in this file.
-- ============================================================

-- collect (file, lowered-text) in order; fails on reserved/dup names.
-- anyrec gates the top-level prelude-collision check; per-file local
-- bindings are checked only in files that use records (legacy-only files
-- stay compilable even if they bind such names: no helpers are emitted
-- into their scope).
let rec g5_lower_files anyrec files acc = case files of
    [] -> rev_acc [] acc
  | f :: rest -> case f of
      | (path, _, pr) -> case pr of
          | Prog5 _ items ->
              let t = if anyrec then g5_has_reserved_top pr else "" in
              if t == "" then
                let l = if g5_uses_records_prog pr then g5_has_reserved_prog pr else "" in
                if l == "" then g5_lower_files anyrec rest ((path, g5_lower_prog_src pr) :: acc)
                else error ("g5: reserved record-helper name `" ++ l ++ "` bound in " ++ path ++ " (rename it)")
              else error ("g5: reserved record-helper name `" ++ t ++ "` defined in " ++ path ++ " (rename it)")

-- NOTE: record-usage is detected on parsed Prog5s (kept alongside texts)
let rec g5_any_records_ps progs = case progs of
    [] -> false
  | pr :: rest ->
      if g5_uses_records_prog pr then true else g5_any_records_ps rest

let rec g5_file_progs files acc = case files of
    [] -> rev_acc [] acc
  | f :: rest -> case f of
      | (_, _, pr) -> g5_file_progs rest (pr :: acc)

let rec g5_join_texts texts acc = case texts of
    [] -> acc
  | kv :: rest -> case kv of
      | (_, t) -> g5_join_texts rest (acc ++ t ++ "\n")

-- duplicate top-level value names across merged files (flat namespace)
let rec g5_def_names_of_prog pr acc = case pr of
  | Prog5 _ items -> g5_def_names_of_items items acc

and g5_def_names_of_items items acc = case items of
    [] -> acc
  | it :: rest -> case it of
      | IDef5 ds _ -> g5_def_names_of_items rest (g5_def_names_app ds acc)
      | _ -> g5_def_names_of_items rest acc

and g5_def_names_app ds acc = case ds of
    [] -> acc
  | d :: rest -> g5_def_names_app rest (def5_name d :: acc)

let rec g5_dup_across namess seen = case namess of
    [] -> ""
  | ns :: rest ->
      let d = g5_first_dup_in ns seen in
      if d == "" then g5_dup_across rest (app_list ns seen)
      else d

and g5_first_dup_in ns seen = case ns of
    [] -> ""
  | n :: rest ->
      if g5_mem_str3 n seen then n else g5_first_dup_in rest seen

let rec g5_main_count namess acc = case namess of
    [] -> acc
  | ns :: rest -> g5_main_count rest (acc + g5_count_main ns)

and g5_count_main ns = case ns of
    [] -> 0
  | n :: rest -> if n == "main" then 1 + g5_count_main rest else g5_count_main rest

let rec g5cc_main () =
  print_string "" ;
  let in_path = argv 1 in
  let out_base = argv 2 in
  let boot = argv 3 == "--backend-only" in
  let _w = if boot then print_string "g5: --backend-only: check skipped (bootstrap hatch; ship only inputs that gen5check accepts)\n" else print_string "" in
  let files = g5_load_files in_path in
  let (status, errmsg) = if boot then ("checked", "") else g5cc_status (g5_check_loaded files in_path) in
  if status == "invalid" then error errmsg
  else if status == "partial" then error "g5: cannot compile partial program (holes must be filled)"
  else
    let progs = g5_file_progs files [] in
    let namesets = g5_namesets progs [] in
    let dup = g5_dup_across namesets [] in
    if dup == "" then
      if g5_main_count namesets 0 > 1 then error "g5: multiple main definitions across modules"
      else
        let toks = g5_lex_all (g5_read_src files in_path) in
        if g5_is_legacy_toks toks then g5cc_legacy in_path out_base
        else g5cc_lowered files progs out_base
    else error ("g5: duplicate definition `" ++ dup ++ "` across modules (flat namespace in v1)")

and g5_namesets progs acc = case progs of
    [] -> rev_acc [] acc
  | pr :: rest -> g5_namesets rest (g5_def_names_of_prog pr [] :: acc)

-- status projection for the bootstrap hatch below (codegen never reads
-- check results: both emit paths consume parse trees only; the check
-- gates by status. --backend-only is equivalent whenever check passes.)
and g5cc_status r = case r of
  | (_, _, _, _, st, e, _, _) -> (st, e)

-- legacy path: original source straight to the legacy backend
and g5cc_legacy in_path out_base =
  let src_code = read_file in_path in
  let toks = lex_all src_code in
  let prog = parse_prog toks in
  g5cc_emit prog out_base

-- Gen5 path: lower each file dep-first (files arrive entry-first; backend
-- initializes top-level thunks in source order), prepend prelude iff
-- records used, reparse
and g5cc_lowered files progs out_base =
  let anyrec = g5_any_records_ps progs in
  let lowered = g5_lower_files anyrec (rev_acc [] files) [] in
  let body = g5_join_texts lowered "" in
  let src = if anyrec then g5_rec_prelude_src ++ body else body in
  let prog = parse_prog (lex_all src) in
  g5cc_emit prog out_base

-- Gen5-RC backend: ownership IR (g5_own.dc) -> reference-counting ARM64
-- (g5_cg.dc / g5_cgdriver.dc), linked against gen5/rt5.c
and g5cc_emit prog out_base =
  let oprog = g5o_program prog in
  let lines_fwd = g5cg_emit_code oprog in
  let content = g5cg_join_lines lines_fwd in
  let s_path = out_base ++ ".s" in
  write_file s_path content ;
  let rt_c = "gen5/rt5.c" in
  let tmpbin = out_base ++ ".linktmp" in
  let r1 = system ("cc -O2 -arch arm64 -c " ++ s_path ++ " -o " ++ out_base ++ ".o") in
  if r1 != 0 then error ("g5: assembler failed on " ++ s_path ++ " (exit " ++ int_to_string (r1 / 256) ++ ")")
  else
    let r2 = system ("cc -O2 -arch arm64 -c " ++ rt_c ++ " -o " ++ out_base ++ ".rt.o") in
    if r2 != 0 then error ("g5: assembler failed on " ++ rt_c ++ " (exit " ++ int_to_string (r2 / 256) ++ ")")
    else
      let r3 = system ("cc " ++ out_base ++ ".o " ++ out_base ++ ".rt.o -o " ++ tmpbin) in
      if r3 != 0 then error ("g5: linker failed for " ++ out_base ++ " (exit " ++ int_to_string (r3 / 256) ++ ")")
      else
        let r4 = system ("mv " ++ tmpbin ++ " " ++ out_base) in
        if r4 != 0 then error ("g5: cannot publish " ++ out_base ++ " (exit " ++ int_to_string (r4 / 256) ++ ")")
        else print_string ("wrote " ++ out_base ++ "\n")

let main () =
  print_string "" ;
  g5cc_main () ;
  print_string ""
