
let main () =
  print_string "" ;
  let in_path = argv 1 in
  let out_base = argv 2 in
  let prog = load_prog in_path in
  let tabs = build_tables prog in
  let all_defs = case tabs of
      | (a, b, c) -> c in
  let ct_id_tbl = case tabs of
      | (a, b, c) -> a in
  let ct_ar_tbl = case tabs of
      | (a, b, c) -> b in

  let lines_fwd = emit_code prog in
  let content = join_chunks lines_fwd in
  let s_path = out_base ++ ".s" in
  write_file s_path content ;
  let rt_c = "gen2-dcc-rs/rt/rt.c" in
  let _r1 = system ("cc -O2 -arch arm64 -c " ++ s_path ++ " -o " ++ out_base ++ ".o") in
  let _r2 = system ("cc -O2 -arch arm64 -c " ++ rt_c ++ " -o " ++ out_base ++ ".rt.o") in
  let _r3 = system ("cc " ++ out_base ++ ".o " ++ out_base ++ ".rt.o -o " ++ out_base) in
  print_string ("wrote " ++ out_base ++ "\n")
