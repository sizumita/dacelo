-- ============================================================
-- interp.dc -- a dacelo interpreter written in dacelo
--
-- runs on: dacelo (gen0-interp-rs)
-- usage:   dacelo interp.dc <target.dc>
--
-- This file must only use features that IT implements itself,
-- because we test it by interpreting its own source:
--   dacelo interp.dc interp.dc <target.dc>
-- ============================================================

-- ---------- generic list helpers ----------

let rec rev_acc onto xs = case xs of
    [] -> onto
  | h :: rest -> rev_acc (h :: onto) rest

let rec mem_str x xs = case xs of
    [] -> false
  | h :: rest -> h == x || mem_str x rest

let rec len xs = case xs of
    [] -> 0
  | _ :: rest -> 1 + len rest

let rec app_list xs ys = case xs of
    [] -> ys
  | h :: rest -> h :: app_list rest ys

let rec join sep xs = case xs of
    [] -> ""
  | h :: [] -> h
  | h :: rest -> h ++ sep ++ join sep rest

-- ---------- tokens ----------

type Tok =
  | TInt Int
  | TStr String
  | TIdent String
  | TUpper String
  | TKw String
  | TSym String

-- ---------- AST ----------

type Pat =
  | PWild
  | PVar String
  | PInt Int
  | PBool Bool
  | PStr String
  | PUnit
  | PTup (List Pat)
  | PCtor String (List Pat)

type Expr =
  | EInt Int
  | EBool Bool
  | EStr String
  | EUnit
  | EVar String
  | ECtor String
  | ELam Pat Expr
  | EApp Expr Expr
  | EBin String Expr Expr
  | EIf Expr Expr Expr
  | ECase Expr (List (Pat, Expr))
  | ELet Bool String Expr Expr
  | ETup (List Expr)

-- ---------- definitions ----------

type Def3 = Def3 Bool String Expr
type Group = Group (List Def3)
type Prog = Prog (List (String, Int)) (List Group)

-- ---------- runtime values ----------

type Val =
  | VInt Int
  | VBool Bool
  | VStr String
  | VUnit
  | VTup (List Val)
  | VLam Pat Expr (List (String, Val))
  | VRecLam String Pat Expr (List (String, Val))
  | VPrim String Int (List Val)
  | VCtorF String Int (List Val)
  | VAdt String (List Val)

-- ============================================================
-- LEXER
-- ============================================================

let sget s i = string_get s i

let is_digit c = 48 <= c && c <= 57
let is_lowerc c = 97 <= c && c <= 122
let is_upperc c = 65 <= c && c <= 90
let is_wordch c = is_digit c || is_lowerc c || is_upperc c || c == 95 || c == 39

let rec skip_line_comment s i =
  let c = sget s i in
  if c == -1 then i
  else if c == 10 then skip_ws s (i + 1)
  else skip_line_comment s (i + 1)

and skip_ws s i =
  let c = sget s i in
  if c == -1 then i
  else if c == 32 || c == 9 || c == 10 || c == 13 then skip_ws s (i + 1)
  else if c == 45 && sget s (i + 1) == 45 then skip_line_comment s (i + 2)
  else i

let rec scan_int_run s i acc =
  let c = sget s i in
  if is_digit c then scan_int_run s (i + 1) (acc * 10 + (c - 48))
  else (acc, i)

let rec word_end s i =
  let c = sget s i in
  if is_wordch c then word_end s (i + 1) else i

let keywords = ["let", "rec", "and", "in", "if", "then", "else", "case", "of",
                "fun", "true", "false", "type"]

let sym2s = ["->", "==", "!=", "<=", ">=", "&&", "||", "++", "::"]

let sub_or_empty s i n =
  if i + n <= string_length s then substring s i n else ""

let is_sym1 c =
  c == 40 || c == 41 || c == 91 || c == 93 || c == 44 || c == 59 ||
  c == 58 || c == 124 || c == 60 || c == 62 || c == 61 || c == 43 ||
  c == 45 || c == 42 || c == 47 || c == 37

let escape_code c = case c of
    110 -> 10
  | 116 -> 9
  | 114 -> 13
  | 92  -> 92
  | 34  -> 34
  | 48  -> 0
  | _   -> error "interp: bad escape sequence in string literal"

let rec chars_str cs = case cs of
    [] -> ""
  | c :: rest -> chr c ++ chars_str rest

let rec scan_string s i acc =
  let c = sget s i in
  if c == -1 then error "interp: unterminated string literal"
  else if c == 34 then (chars_str (rev_acc [] acc), i + 1)
  else if c == 92 then
    let e = sget s (i + 1) in
    if e == -1 then error "interp: unterminated string literal"
    else scan_string s (i + 2) (escape_code e :: acc)
  else scan_string s (i + 1) (c :: acc)

let rec lex_loop s i acc =
  let j = skip_ws s i in
  let c = sget s j in
  if c == -1 then rev_acc [] acc
  else if is_digit c then
    let (n, k) = scan_int_run s j 0 in
    lex_loop s k (TInt n :: acc)
  else if c == 34 then
    let (t, k) = scan_string s (j + 1) [] in
    lex_loop s k (TStr t :: acc)
  else if is_lowerc c || c == 95 then
    let k = word_end s j in
    let w = substring s j (k - j) in
    if mem_str w keywords
    then lex_loop s k (TKw w :: acc)
    else lex_loop s k (TIdent w :: acc)
  else if is_upperc c then
    let k = word_end s j in
    let w = substring s j (k - j) in
    lex_loop s k (TUpper w :: acc)
  else
    let two = sub_or_empty s j 2 in
    if mem_str two sym2s
    then lex_loop s (j + 2) (TSym two :: acc)
    else if is_sym1 c
    then lex_loop s (j + 1) (TSym (chr c) :: acc)
    else error ("interp: unexpected character (code " ++ int_to_string c ++ ")")

let lex_all src = lex_loop src 0 []

-- ============================================================
-- PARSER (token stream passing)
-- ============================================================

let is_sym q toks = case toks of
  | TSym x :: _ -> x == q
  | _ -> false

let is_kw q toks = case toks of
  | TKw x :: _ -> x == q
  | _ -> false

let drop1 toks = case toks of
  | _ :: rest -> rest
  | [] -> []

let expect_sym q toks =
  if is_sym q toks then drop1 toks
  else error ("interp: expected `" ++ q ++ "`")

let expect_kw q toks =
  if is_kw q toks then drop1 toks
  else error ("interp: expected keyword `" ++ q ++ "`")

let take_ident toks = case toks of
  | TIdent n :: rest -> (n, rest)
  | _ -> error "interp: expected identifier"

let take_upper toks = case toks of
  | TUpper n :: rest -> (n, rest)
  | _ -> error "interp: expected constructor name"

let starts_tyatom toks = case toks of
  | TIdent _ :: _ -> true
  | TUpper _ :: _ -> true
  | TSym "(" :: _ -> true
  | TSym "[" :: _ -> true
  | _ -> false

let rec ptyatom toks = case toks of
  | TIdent _ :: rest -> rest
  | TUpper _ :: rest -> rest
  | TSym "(" :: rest ->
      if is_sym ")" rest then drop1 rest
      else
        let t1 = ptype rest in
        let t2 = pmore_tytuple t1 in
        expect_sym ")" t2
  | TSym "[" :: rest ->
      let t1 = ptype rest in
      expect_sym "]" t1
  | _ -> error "interp: expected type"

and pmore_tytuple toks =
  if is_sym "," toks then pmore_tytuple (ptype (drop1 toks))
  else toks

and ptyapp toks =
  let t1 = ptyatom toks in
  if starts_tyatom t1 then ptyapp t1 else t1

and ptype toks =
  let t1 = ptyapp toks in
  if is_sym "->" t1 then ptype (drop1 t1) else t1

let eat_ann_opt toks =
  if is_sym ":" toks then ptype (drop1 toks) else toks

-- ---- expressions ----

let starts_atom toks = case toks of
  | TInt _ :: _ -> true
  | TStr _ :: _ -> true
  | TIdent _ :: _ -> true
  | TUpper _ :: _ -> true
  | TKw "true" :: _ -> true
  | TKw "false" :: _ -> true
  | TSym "(" :: _ -> true
  | TSym "[" :: _ -> true
  | _ -> false

let rec wrap_lams ps body = case ps of
    [] -> body
  | p :: rest -> ELam p (wrap_lams rest body)

-- standalone parser helpers
type OptS = None2 | Some2 String


let cmp_op_of toks = case toks of
  | TSym "==" :: _ -> Some2 "=="
  | TSym "!=" :: _ -> Some2 "!="
  | TSym "<" :: _ -> Some2 "<"
  | TSym ">" :: _ -> Some2 ">"
  | TSym "<=" :: _ -> Some2 "<="
  | TSym ">=" :: _ -> Some2 ">="
  | _ -> None2


let mk_cons l r = EApp (EApp (ECtor "Cons") l) r


let rec build_cons xs = case xs of
    [] -> ECtor "Nil"
  | h :: rest -> mk_cons h (build_cons rest)


let pat_nil = PCtor "Nil" []


let rec build_pcons xs = case xs of
    [] -> pat_nil
  | h :: rest -> PCtor "Cons" [h, build_pcons rest]


let starts_pat_atom toks = case toks of
  | TInt _ :: _ -> true
  | TStr _ :: _ -> true
  | TIdent _ :: _ -> true
  | TUpper _ :: _ -> true
  | TKw "true" :: _ -> true
  | TKw "false" :: _ -> true
  | TSym "(" :: _ -> true
  | TSym "[" :: _ -> true
  | _ -> false

let rec pmany_param toks acc = case toks of
  | TIdent _ :: _ -> let (p, t) = ppat_atom toks in pmany_param t (p :: acc)
  | TSym "_" :: _ -> let (p, t) = ppat_atom toks in pmany_param t (p :: acc)
  | TSym "(" :: _ -> let (p, t) = ppat_atom toks in pmany_param t (p :: acc)
  | _ -> (rev_acc [] acc, toks)

and plist_elems toks acc =
  let (e, t1) = pexpr toks in
  let acc2 = e :: acc in
  if is_sym "," t1 then plist_elems (drop1 t1) acc2
  else
    let t2 = expect_sym "]" t1 in
    (build_cons (rev_acc [] acc2), t2)

and plist_pats toks acc =
  let (p, t1) = ppattern toks in
  let acc2 = p :: acc in
  if is_sym "," t1 then plist_pats (drop1 t1) acc2
  else
    let t2 = expect_sym "]" t1 in
    (build_pcons (rev_acc [] acc2), t2)

and ptuple_more toks acc =
  let (e, t1) = pexpr toks in
  let acc2 = e :: acc in
  if is_sym "," t1 then ptuple_more (drop1 t1) acc2
  else
    let t2 = expect_sym ")" t1 in
    (ETup (rev_acc [] acc2), t2)

and ptuple_pats_more toks acc =
  let (p, t1) = ppattern toks in
  let acc2 = p :: acc in
  if is_sym "," t1 then ptuple_pats_more (drop1 t1) acc2
  else
    let t2 = expect_sym ")" t1 in
    (PTup (rev_acc [] acc2), t2)

and patom toks = case toks of
  | TInt n :: rest -> (EInt n, rest)
  | TStr s :: rest -> (EStr s, rest)
  | TKw "true" :: rest -> (EBool true, rest)
  | TKw "false" :: rest -> (EBool false, rest)
  | TIdent n :: rest -> (EVar n, rest)
  | TUpper c :: rest -> (ECtor c, rest)
  | TSym "-" :: TInt n :: rest -> (EInt (0 - n), rest)
  | TSym "(" :: rest ->
      if is_sym ")" rest then (EUnit, drop1 rest)
      else
        let (e, t1) = pexpr rest in
        if is_sym "," t1 then ptuple_more (drop1 t1) [e]
        else (e, expect_sym ")" t1)
  | TSym "[" :: rest ->
      if is_sym "]" rest then (ECtor "Nil", drop1 rest)
      else plist_elems rest []
  | _ -> error "interp: expected expression"

and papp_loop f toks =
  if starts_atom toks then
    let (a, t1) = patom toks in
    papp_loop (EApp f a) t1
  else (f, toks)

and papp toks =
  let (a, t1) = patom toks in
  papp_loop a t1

and pmul_loop l toks =
  if is_sym "*" toks then
    let (r, t1) = papp (drop1 toks) in pmul_loop (EBin "*" l r) t1
  else if is_sym "/" toks then
    let (r, t1) = papp (drop1 toks) in pmul_loop (EBin "/" l r) t1
  else if is_sym "%" toks then
    let (r, t1) = papp (drop1 toks) in pmul_loop (EBin "%" l r) t1
  else (l, toks)

and pmul toks =
  let (l, t1) = papp toks in pmul_loop l t1

and padd_loop l toks =
  if is_sym "+" toks then
    let (r, t1) = pmul (drop1 toks) in padd_loop (EBin "+" l r) t1
  else if is_sym "-" toks then
    let (r, t1) = pmul (drop1 toks) in padd_loop (EBin "-" l r) t1
  else (l, toks)

and padd toks =
  let (l, t1) = pmul toks in padd_loop l t1

and pcons toks =
  let (l, t1) = padd toks in
  if is_sym "::" t1 then
    let (r, t2) = pcons (drop1 t1) in
    (mk_cons l r, t2)
  else if is_sym "++" t1 then
    let (r, t2) = pcons (drop1 t1) in
    (EBin "++" l r, t2)
  else (l, t1)

and pcmp toks =
  let (l, t1) = pcons toks in
  case cmp_op_of t1 of
    | None2 -> (l, t1)
    | Some2 op ->
        let (r, t2) = pcons (drop1 t1) in
        (EBin op l r, t2)

and pand_loop l toks =
  if is_sym "&&" toks then
    let (r, t1) = pcmp (drop1 toks) in pand_loop (EBin "&&" l r) t1
  else (l, toks)

and pand toks =
  let (l, t1) = pcmp toks in pand_loop l t1

and por_loop l toks =
  if is_sym "||" toks then
    let (r, t1) = pand (drop1 toks) in por_loop (EBin "||" l r) t1
  else (l, toks)

and por toks =
  let (l, t1) = pand toks in por_loop l t1

and pann toks =
  let (l, t1) = por toks in
  if is_sym ":" t1 then (l, ptype (drop1 t1))
  else (l, t1)

and pseq toks =
  let (l, t1) = pann toks in
  if is_sym ";" t1 then
    let (r, t2) = pexpr (drop1 t1) in
    (ELet false "_" l r, t2)
  else (l, t1)

and pplet toks =
  let (p, t1) = ppat_atom toks in
  let t2 = expect_sym "=" t1 in
  let (rhs, t3) = pexpr t2 in
  let t4 = expect_kw "in" t3 in
  let (body, t5) = pexpr t4 in
  (ECase rhs [(p, body)], t5)

and pbranches toks acc =
  let (p, t1) = ppattern toks in
  let t2 = expect_sym "->" t1 in
  let (b, t3) = pexpr t2 in
  let acc2 = (p, b) :: acc in
  if is_sym "|" t3 then pbranches (drop1 t3) acc2
  else (rev_acc [] acc2, t3)

and pexpr toks =
  if is_kw "fun" toks then
    let (ps, t1) = pmany_param (drop1 toks) [] in
    let t2 = expect_sym "->" t1 in
    let (b, t3) = pexpr t2 in
    (wrap_lams ps b, t3)
  else if is_kw "if" toks then
    let (c, t1) = pexpr (drop1 toks) in
    let t2 = expect_kw "then" t1 in
    let (th, t3) = pexpr t2 in
    let t4 = expect_kw "else" t3 in
    let (el, t5) = pexpr t4 in
    (EIf c th el, t5)
  else if is_kw "case" toks then
    let (sc, t1) = pexpr (drop1 toks) in
    let t2 = expect_kw "of" t1 in
    let t3 = (case t2 of | TSym "|" :: rest -> rest | _ -> t2) in
    let (brs, t4) = pbranches t3 [] in
    (ECase sc brs, t4)
  else if is_kw "let" toks then
    (case drop1 toks of
       | TSym "(" :: _ -> pplet (drop1 toks)
       | _ -> plocal_let (drop1 toks))
  else pseq toks

and plocal_let toks =
  let (isrec, t1) = (case toks of
                         | TKw "rec" :: rest -> (true, rest)
                         | r -> (false, r)) in
  let (name, t2) = take_ident t1 in
  let (params, t3) = pmany_param t2 [] in
  let t4 = eat_ann_opt t3 in
  let t5 = expect_sym "=" t4 in
  let (rhs, t6) = pexpr t5 in
  let t7 = expect_kw "in" t6 in
  let (body, t8) = pexpr t7 in
  (ELet isrec name (wrap_lams params rhs) body, t8)

-- ---- patterns ----

and ppat_atom toks = case toks of
  | TIdent "_" :: rest -> (PWild, rest)
  | TIdent n :: rest -> (PVar n, rest)
  | TInt n :: rest -> (PInt n, rest)
  | TStr s :: rest -> (PStr s, rest)
  | TKw "true" :: rest -> (PBool true, rest)
  | TKw "false" :: rest -> (PBool false, rest)
  | TSym "(" :: rest ->
      if is_sym ")" rest then (PUnit, drop1 rest)
      else
        let (p, t1) = ppattern rest in
        if is_sym "," t1 then ptuple_pats_more (drop1 t1) [p]
        else (p, expect_sym ")" t1)
  | TSym "[" :: rest ->
      if is_sym "]" rest then (pat_nil, drop1 rest)
      else plist_pats rest []
  | _ -> error "interp: expected pattern"

and ppat_app toks = case toks of
  | TUpper c :: rest ->
      let (args, t1) = pmany_pat_atom rest [] in
      (PCtor c args, t1)
  | _ -> ppat_atom toks

and pmany_pat_atom toks acc =
  if starts_pat_atom toks then
    let (p, t1) = ppat_atom toks in
    pmany_pat_atom t1 (p :: acc)
  else (rev_acc [] acc, toks)

and ppattern toks =
  let (l, t1) = ppat_app toks in
  if is_sym "::" t1 then
    let (r, t2) = ppattern (drop1 t1) in
    (PCtor "Cons" [l, r], t2)
  else (l, t1)

-- ---- top-level items ----

let rec pparams_only toks acc = case toks of
  | TIdent _ :: _ -> let (n, t) = take_ident toks in pparams_only t (n :: acc)
  | _ -> (rev_acc [] acc, toks)

let pdef_tail isrec toks =
  let (name, t1) = take_ident toks in
  let (params, t2) = pmany_param t1 [] in
  let t3 = eat_ann_opt t2 in
  let t4 = expect_sym "=" t3 in
  let (rhs, t5) = pexpr t4 in
  (Def3 isrec name (wrap_lams params rhs), t5)

let rec pctrs toks acc =
  let (cname, t1) = take_upper toks in
  let (fields, t2) = ptyapp_count t1 0 in
  let acc2 = (cname, fields) :: acc in
  if is_sym "|" t2 then pctrs (drop1 t2) acc2
  else (acc2, t2)

and ptyapp_count toks n =
  if starts_tyatom toks then
    let t1 = ptyatom toks in
    if starts_tyatom t1 then ptyapp_count t1 (n + 1) else (n + 1, t1)
  else (n, toks)

let ptydef toks = case toks of
  | TUpper name :: rest ->
      let (_, t1) = pparams_only rest [] in
      let t2 = expect_sym "=" t1 in
      let t3 = (case t2 of | TSym "|" :: r -> r | _ -> t2) in
      let (cds, t4) = pctrs t3 [] in
      ((name, rev_acc [] cds), t4)
  | _ -> error "interp: expected type name"

let next_is_and toks = case toks of
  | TKw "and" :: _ -> true
  | _ -> false

let rec push_pairs xs acc = case xs of
    [] -> acc
  | h :: rest -> push_pairs rest (h :: acc)

let rec pand_chain toks acc =
  let t0 = expect_kw "and" toks in
  let (d, t1) = pdef_tail true t0 in
  let acc2 = d :: acc in
  if next_is_and t1 then pand_chain t1 acc2
  else (Group (rev_acc [] acc2), t1)

let pand_chain_cont toks first =
  let (grp_d, t1) = pand_chain toks [first] in
  (grp_d, t1)

let rec pitems toks ctors groups = case toks of
  | [] -> (Prog (rev_acc [] ctors) (rev_acc [] groups), [])
  | TKw "type" :: rest ->
      let ((_, cds), t1) = ptydef rest in
      pitems t1 (push_pairs cds ctors) groups
  | TKw "let" :: rest ->
      let (isrec, t1) = (case rest of
                           | TKw "rec" :: r -> (true, r)
                           | r -> (false, r)) in
      let (d, t2) = pdef_tail isrec t1 in
      if next_is_and t2 && isrec then
        let (grp, t3) = pand_chain_cont t2 d in
        pitems t3 ctors (grp :: groups)
      else if next_is_and t2 then
        error "interp: `and` is only allowed after `let rec`"
      else
        pitems t2 ctors (Group [d] :: groups)
  | _ -> error "interp: expected top-level item (`let` or `type`)"

let parse_prog toks =
  let (prog, rest) = pitems toks [] [] in
  case rest of
    | [] -> prog
    | _ -> error "interp: trailing tokens after program"

-- ============================================================
-- EVALUATOR
--
-- Every eval call threads the FINAL global frame `gs`: names not
-- found in the lexical environment are resolved against it at call
-- time. This makes top-level mutual recursion (`and` groups) work
-- without any mutation.
-- ============================================================

type Maybe a = MNothing | MJust a

let rec env_get env n = case env of
    [] -> MNothing
  | kv :: rest -> (case kv of
                     | (kn, vv) -> if kn == n then MJust vv else env_get rest n)

let prim1s = ["print_int", "print_string", "int_to_string", "bool_to_string",
              "string_length", "str_concat", "read_file", "exit", "chr",
              "ord", "string_to_int", "error", "show", "argv"]

let prim_arity n =
  if n == "write_file" || n == "string_get" then 2
  else if n == "substring" then 3
  else if mem_str n prim1s then 1
  else -1

let un_int v = case v of | VInt x -> x | _ -> error "interp: expected an Int"
let un_str v = case v of | VStr x -> x | _ -> error "interp: expected a String"
let un_bool v = case v of | VBool x -> x | _ -> error "interp: expected a Bool"

let rec eq_vals xs ys = case (xs, ys) of
    ([], []) -> true
  | (x :: xr, y :: yr) -> val_eq x y && eq_vals xr yr
  | _ -> false

and val_eq a b = case (a, b) of
  | (VInt x, VInt y) -> x == y
  | (VBool x, VBool y) -> x == y
  | (VStr x, VStr y) -> x == y
  | (VUnit, VUnit) -> true
  | (VTup xs, VTup ys) -> len xs == len ys && eq_vals xs ys
  | (VAdt n1 fs1, VAdt n2 fs2) -> n1 == n2 && eq_vals fs1 fs2
  | _ -> error "interp: cannot compare these values"

let rec join_show sep xs = case xs of
    [] -> ""
  | h :: [] -> show_val h
  | h :: rest -> show_val h ++ sep ++ join_show sep rest

and show_val v = case v of
  | VInt n -> int_to_string n
  | VBool b -> bool_to_string b
  | VStr s -> s
  | VUnit -> "()"
  | VTup vs -> "(" ++ join_show ", " vs ++ ")"
  | VAdt "Nil" [] -> "[]"
  | VAdt "Cons" [h, t] -> "[" ++ cons_body h t ++ "]"
  | VAdt n [] -> n
  | VAdt n fs -> "(" ++ n ++ " " ++ join_show " " fs ++ ")"
  | _ -> "<fun>"

and cons_body h t = case t of
  | VAdt "Nil" [] -> show_val h
  | VAdt "Cons" [h2, t2] -> show_val h ++ "," ++ cons_body h2 t2
  | other -> show_val h ++ "," ++ show_val other

-- argument extraction (arity already checked by saturation)
let prim_a args = case args of
  | x :: _ -> x
  | _ -> error "interp: builtin arity bug"

let prim_b args = case args of
  | _ :: y :: _ -> y
  | _ -> error "interp: builtin arity bug"

let prim_c args = case args of
  | _ :: _ :: z :: _ -> z
  | _ -> error "interp: builtin arity bug"

let call_prim name args sh =
  if name == "print_int" then
    print_int (un_int (prim_a args)) ; VUnit
  else if name == "print_string" then
    print_string (un_str (prim_a args)) ; VUnit
  else if name == "int_to_string" then
    VStr (int_to_string (un_int (prim_a args)))
  else if name == "bool_to_string" then
    VStr (bool_to_string (un_bool (prim_a args)))
  else if name == "string_length" then
    VInt (string_length (un_str (prim_a args)))
  else if name == "str_concat" then
    VStr (un_str (prim_a args) ++ un_str (prim_b args))
  else if name == "read_file" then
    VStr (read_file (un_str (prim_a args)))
  else if name == "write_file" then
    write_file (un_str (prim_a args)) (un_str (prim_b args)) ; VUnit
  else if name == "exit" then
    exit (un_int (prim_a args)) ; VUnit
  else if name == "chr" then
    VStr (chr (un_int (prim_a args)))
  else if name == "ord" then
    VInt (ord (un_str (prim_a args)))
  else if name == "string_get" then
    VInt (string_get (un_str (prim_a args)) (un_int (prim_b args)))
  else if name == "substring" then
    VStr (substring (un_str (prim_a args)) (un_int (prim_b args)) (un_int (prim_c args)))
  else if name == "string_to_int" then
    VInt (string_to_int (un_str (prim_a args)))
  else if name == "error" then
    error (un_str (prim_a args))
  else if name == "show" then
    VStr (show_val (prim_a args))
  else if name == "argv" then
    VStr (argv (un_int (prim_a args) + sh))
  else error ("interp: unknown primitive `" ++ name ++ "`")

-- ---- pattern matching ----

type MB = MNo | MYes (List (String, Val))

let rec mpat p v acc = case p of
  | PWild -> MYes acc
  | PVar n -> if n == "_" then MYes acc else MYes ((n, v) :: acc)
  | PInt k -> (case v of
                 | VInt x -> if x == k then MYes acc else MNo
                 | _ -> MNo)
  | PBool b -> (case v of
                  | VBool x -> if x == b then MYes acc else MNo
                  | _ -> MNo)
  | PStr s -> (case v of
                 | VStr x -> if x == s then MYes acc else MNo
                 | _ -> MNo)
  | PUnit -> (case v of
                | VUnit -> MYes acc
                | _ -> MNo)
  | PTup ps -> (case v of
                  | VTup vs ->
                      if len ps == len vs then mmany ps vs acc else MNo
                  | _ -> MNo)
  | PCtor cn ps -> (case v of
                      | VAdt vn fs ->
                          if cn == vn && len ps == len fs
                          then mmany ps fs acc
                          else MNo
                      | _ -> MNo)

and mmany ps vs acc = case (ps, vs) of
    ([], []) -> MYes acc
  | (p :: prest, v :: vrest) ->
      (case mpat p v acc of
         | MNo -> MNo
         | MYes acc2 -> mmany prest vrest acc2)
  | _ -> MNo

-- ---- the evaluator core ----

let rec int_op op a b =
  if op == "+" then VInt (a + b)
  else if op == "-" then VInt (a - b)
  else if op == "*" then VInt (a * b)
  else if op == "/" then
    (if b == 0 then error "interp: division by zero" else VInt (a / b))
  else if op == "%" then
    (if b == 0 then error "interp: modulo by zero" else VInt (a % b))
  else error ("interp: bad arithmetic operator `" ++ op ++ "`")

let rec int_cmp op a b =
  if op == "<" then VBool (a < b)
  else if op == ">" then VBool (a > b)
  else if op == "<=" then VBool (a <= b)
  else if op == ">=" then VBool (a >= b)
  else error ("interp: bad comparison operator `" ++ op ++ "`")

and binop cs gs sh env op l r =
  let lv = eval cs gs sh env l in
  let rv = eval cs gs sh env r in
  if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" then
    int_op op (un_int lv) (un_int rv)
  else if op == "++" then VStr (un_str lv ++ un_str rv)
  else if op == "==" then VBool (val_eq lv rv)
  else if op == "!=" then VBool ((if val_eq lv rv then false else true))
  else if op == "<" || op == ">" || op == "<=" || op == ">=" then
    int_cmp op (un_int lv) (un_int rv)
  else error ("interp: bad operator `" ++ op ++ "`")

and run_branch cs gs sh env branches sv = case branches of
    [] -> error ("non-exhaustive pattern match on " ++ show_val sv)
  | br :: rest -> (case br of
                     | (p, body) ->
                         (case mpat p sv [] of
                            | MNo -> run_branch cs gs sh env rest sv
                            | MYes binds -> eval cs gs sh (app_list binds env) body))

and eval cs gs sh env e = case e of
  | EInt n -> VInt n
  | EBool b -> VBool b
  | EStr s -> VStr s
  | EUnit -> VUnit
  | EVar n ->
      (case env_get env n of
         | MJust v -> v
         | MNothing ->
             (case env_get gs n of
                | MJust v -> v
                | MNothing ->
                    (let ar = prim_arity n in
                     if ar < 0
                     then error ("interp: unbound variable `" ++ n ++ "`")
                     else VPrim n ar [])))
  | ECtor c ->
      (case env_get cs c of
         | MJust 0 -> VAdt c []
         | MJust k -> VCtorF c k []
         | MNothing -> error ("interp: unknown constructor `" ++ c ++ "`"))
  | ELam p b -> VLam p b env
  | EApp fe ae ->
      let fv = eval cs gs sh env fe in
      let av = eval cs gs sh env ae in
      applyv cs gs sh fv av
  | EBin op l r ->
      if op == "&&" then
        (case eval cs gs sh env l of
           | VBool false -> VBool false
           | VBool true -> VBool (un_bool (eval cs gs sh env r))
           | _ -> error "interp: && expects Bools")
      else if op == "||" then
        (case eval cs gs sh env l of
           | VBool true -> VBool true
           | VBool false -> VBool (un_bool (eval cs gs sh env r))
           | _ -> error "interp: || expects Bools")
      else binop cs gs sh env op l r
  | EIf c th el ->
      (case eval cs gs sh env c of
         | VBool true -> eval cs gs sh env th
         | VBool false -> eval cs gs sh env el
         | _ -> error "interp: if condition must be Bool")
  | ECase sc branches ->
      let sv = eval cs gs sh env sc in
      run_branch cs gs sh env branches sv
  | ELet isrec name rhs body ->
      let rv = eval cs gs sh env rhs in
      let rv2 = (case rv of
                   | VLam p b cenv -> (if isrec then VRecLam name p b cenv else VLam p b cenv)
                   | other -> other) in
      eval cs gs sh ((name, rv2) :: env) body
  | ETup es -> VTup (evall cs gs sh env es)

and evall cs gs sh env es = case es of
    [] -> []
  | e :: rest -> eval cs gs sh env e :: evall cs gs sh env rest

and applyv cs gs sh f a = case f of
  | VLam p b env ->
      (case mpat p a [] of
         | MNo -> error "interp: parameter pattern match failed"
         | MYes binds -> eval cs gs sh (app_list binds env) b)
  | VRecLam self p b env ->
      (case mpat p a [] of
         | MNo -> error "interp: parameter pattern match failed"
         | MYes binds -> eval cs gs sh (app_list binds ((self, f) :: env)) b)
  | VPrim nm ar args ->
      let args2 = app_list args [a] in
      if len args2 == ar then call_prim nm args2 sh
      else VPrim nm ar args2
  | VCtorF nm ar args ->
      let args2 = app_list args [a] in
      if len args2 == ar then VAdt nm args2
      else VCtorF nm ar args2
  | _ -> error ("interp: cannot apply non-function value " ++ show_val f)

-- ---- driver ----

let rec run_defs cs env ds = case ds of
    [] -> env
  | d :: drest -> (case d of
                     | Def3 _ name rhs ->
                         -- construct closures; globals-so-far passed as `gs`
                         -- so value-level defs can use earlier definitions
                         let v = eval cs env 0 [] rhs in
                         run_defs cs ((name, v) :: env) drest)

let rec run_groups cs groups env = case groups of
    [] -> env
  | g :: rest -> (case g of
                    | Group ds -> run_groups cs rest (run_defs cs env ds))

let ignorev v = ()

-- The program to interpret is argv 1 (argv 0 is this script).
-- Programs we interpret see THEMSELVES at argv 0: their argv calls
-- go through call_prim which adds `sh`. Running on gen0 directly,
-- our own view already has us at 0, so children get shift = 1.
let main () =
  let path = argv 1 in
  let src = read_file path in
  let toks = lex_all src in
  let prog = parse_prog toks in
  case prog of
    | Prog ctors groups ->
        let ctors2 = app_list [("Nil", 0), ("Cons", 2)] ctors in
        let envf = rev_acc [] (run_groups ctors2 groups []) in
        (case env_get envf "main" of
           | MJust f -> ignorev (applyv ctors2 envf 1 f VUnit)
           | MNothing -> ())
